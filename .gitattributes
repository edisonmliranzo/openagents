# Enforce LF line endings for shell scripts and cross-platform text files.
# Prevents Windows CRLF checkout breaking `#!/bin/bash` / `#!/usr/bin/env node`.
*.sh text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.md text eol=lf
.env.example text eol=lf
.env.prod.example text eol=lf
